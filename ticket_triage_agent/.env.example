MODEL_PROVIDER=bedrock_converse
MODEL_NAME=us.anthropic.claude-sonnet-4-6
TEMPERATURE=0
CONFIDENCE_THRESHOLD=0.7
MAX_ITERATIONS=10
MAX_REVISIONS=2
MAX_TOOL_CALLS=8
HITL_PRIORITIES=P1
HITL_SENTIMENTS=negative
HITL_CATEGORIES=refund,security,legal
INVESTIGATION_CATEGORIES=billing,technical,account,shipping,refund,security,legal,other

# Long-term memory. Unset EMBEDDING_MODEL keeps tests on fake embeddings.
MEMORY_DB_PATH=data/memory.sqlite
CHECKPOINT_DB_PATH=data/checkpoints.sqlite
OUTBOX_DIR=outbox
ESCALATIONS_DIR=escalations
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIMS=1024
KB_MIN_SCORE=0.2
KB_RELATIVE_MARGIN=0.1

# Bedrock credentials. boto3 also accepts a profile or role.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional. Leave unset to keep LangSmith off.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
