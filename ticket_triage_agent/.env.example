MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.5
TEMPERATURE=0
CONFIDENCE_THRESHOLD=0.7
MAX_ITERATIONS=10
MAX_REVISIONS=2
MAX_TOOL_CALLS=6
HITL_PRIORITIES=P1
HITL_SENTIMENTS=negative
HITL_CATEGORIES=refund,security,legal
INVESTIGATION_CATEGORIES=billing,technical,account,shipping,refund,security,legal,other

# Long-term memory. Unset EMBEDDING_MODEL keeps tests on fake embeddings.
MEMORY_DB_PATH=data/memory.sqlite
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
KB_MIN_SCORE=0.2
KB_RELATIVE_MARGIN=0.1

# Optional. Leave unset to keep LangSmith off.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
