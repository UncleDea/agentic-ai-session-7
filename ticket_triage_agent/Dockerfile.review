FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY scripts/review_app.py ./scripts/review_app.py

RUN pip install --no-cache-dir .

EXPOSE 8080

CMD ["python", "-m", "streamlit", "run", "scripts/review_app.py", "--server.port=8080", "--server.address=0.0.0.0", "--server.headless=true", "--server.enableCORS=false", "--server.enableXsrfProtection=false", "--server.enableWebsocketCompression=false"]
